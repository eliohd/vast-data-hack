# Copy to server/.env for local dev. On the lab VM you usually need nothing here:
# the organisers' /config/<team>.config is read automatically (see app/config.py).
# Never commit real values.

# VSS retrieval backend (private — only reachable from the lab VM)
VSS_URL=
VSS_USERNAME=
VSS_PASSWORD=
VSS_VERIFY_TLS=true

# GPU endpoints (public, bearer token)
GPU_BEARER_TOKEN=
COSMOS_REASON_URL=
COSMOS_REASON_MODEL=
COSMOS_EMBED_URL=
COSMOS_EMBED_MODEL=
YOLO_URL=
CANARY_URL=

# W&B Inference + Weave
WANDB_API_KEY=
WANDB_TEAM=
WANDB_PROJECT=
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
TRACING=true

# RideAhead
ORS_API_KEY=                 # openrouteservice key; empty → fixture routes (labelled)
RIDEAHEAD_ROUTING=auto       # auto | fixture | ors
RIDEAHEAD_PERCEPTION=archive # archive (lane C cached model outputs) | fixture
RIDEAHEAD_SCENARIO=scenario_nyc.json  # scenario.json = synthetic London fixture
RIDEAHEAD_SNAPSHOTS=false

# App
ANALYSER=auto        # auto | stub | cosmos
DEMO_KEY=            # set to require ?key=… on the public URL
RATE_LIMIT_PER_MINUTE=240
